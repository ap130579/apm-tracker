      "urgent": true,
      "ats": {
        "type": "themuse",
        "company": "TikTok",
        "pages": 60,
        "queries": [
          "product manager graduate 2027",
          "ai product manager graduate 2027",
          "product manager graduate"
        ],
        "direct_sites_note": "careers.tiktok.com and lifeattiktok.com are fully client-rendered and their internal search API returns an empty body to unauthenticated callers \u2014 not scrapeable from the sandbox. The Muse is the structured stand-in; the SimplifyJobs feed provides a second, independent path via fetch_aggregator."
      }
